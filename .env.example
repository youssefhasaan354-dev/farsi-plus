# Supabase Client Configuration (Public Anon Key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Google AdSense (leave blank or comment out until AdSense is configured)
# VITE_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx

# Optional: Stripe Public Key for client checkout (Never put secret keys in frontend!)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
